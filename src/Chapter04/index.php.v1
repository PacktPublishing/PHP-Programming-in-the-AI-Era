<?php
declare(strict_types=1);
require_once __DIR__ . '/../src/Appointment/Appointment.php';
require_once __DIR__ . '/../src/Appointment/ApptAdapter.php';
require_once __DIR__ . '/../src/Appointment/ApptRepository.php';
require_once __DIR__ . '/../src/Appointment/ApptService.php';

use Cookbook\Appointment\ApptRepository;
use Cookbook\Appointment\ApptService;

$config = require __DIR__ . '/../config.php';
$repo   = new ApptRepository($config);
$svc    = new ApptService($repo);

// ── Delete (Post/Redirect/Get) ────────────────────────────────────────────
if ($_SERVER['REQUEST_METHOD'] === 'POST' && ($_POST['action'] ?? '') === 'delete') {
    $id = (int) ($_POST['id'] ?? 0);
    if ($id > 0 && ($appt = $svc->getById($id))) {
        $repo->delete($appt);
    }
    header('Location: index.php?' . http_build_query([
        'start_date' => $_POST['start_date'] ?? '',
        'end_date'   => $_POST['end_date']   ?? '',
        'page'       => max(1, (int) ($_POST['page'] ?? 1)),
        'msg'        => 'deleted',
    ]));
    exit;
}

// ── Inputs ────────────────────────────────────────────────────────────────
$start_date = trim($_GET['start_date'] ?? '');
$end_date   = trim($_GET['end_date']   ?? '');
$page       = max(1, (int) ($_GET['page'] ?? 1));

$result = $svc->list($start_date, $end_date, $page);
['rows' => $rows, 'total' => $total, 'pages' => $pages, 'page' => $page] = $result;

// ── Helpers ───────────────────────────────────────────────────────────────
function h(string $s): string
{
    return htmlspecialchars($s, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}
function fmtDt(string $dt): string
{
    return $dt !== '' ? date('M j, Y g:i A', strtotime($dt)) : '—';
}
function pageUrl(array $base, int $p): string
{
    return 'index.php?' . http_build_query(array_merge($base, ['page' => $p]));
}

$flashMap = [
    'deleted' => ['success', '<i class="bi bi-check-circle-fill me-2"></i>Appointment deleted.'],
    'added'   => ['success', '<i class="bi bi-check-circle-fill me-2"></i>Appointment added.'],
    'edited'  => ['success', '<i class="bi bi-check-circle-fill me-2"></i>Appointment updated.'],
];
[$flashType, $flashHtml] = $flashMap[$_GET['msg'] ?? ''] ?? ['', ''];
$filterParams = array_filter(['start_date' => $start_date, 'end_date' => $end_date]);
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Appointments</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body            { background: #f0f2f5; }
        .navbar         { box-shadow: 0 2px 6px rgba(0,0,0,.18); }
        .card           { border: none; }
        .table thead th {
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .06em;
            white-space: nowrap;
        }
        .btn-icon       { padding: .25rem .5rem; line-height: 1; }
    </style>
</head>
<body>

<nav class="navbar navbar-dark bg-primary mb-4">
    <div class="container-lg">
        <span class="navbar-brand fw-bold fs-5">
            <i class="bi bi-calendar2-check me-2"></i>Appointment Manager
        </span>
        <a href="edit.php" class="btn btn-light btn-sm fw-semibold">
            <i class="bi bi-plus-lg me-1"></i>New Appointment
        </a>
    </div>
</nav>

<div class="container-lg pb-5">

    <?php if ($flashType): ?>
    <div class="alert alert-<?= $flashType ?> alert-dismissible fade show shadow-sm" role="alert">
        <?= $flashHtml ?>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <?php endif; ?>

    <!-- Filter card -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h6 class="text-uppercase text-muted fw-semibold mb-3" style="font-size:.72rem;letter-spacing:.08em;">
                <i class="bi bi-funnel me-1"></i>Filter by Date Range
            </h6>
            <form method="get" action="index.php" class="row g-3 align-items-end">
                <div class="col-sm-5 col-md-4">
                    <label class="form-label fw-medium small" for="start_date">From</label>
                    <input type="date" class="form-control" id="start_date" name="start_date"
                           value="<?= h($start_date) ?>">
                </div>
                <div class="col-sm-5 col-md-4">
                    <label class="form-label fw-medium small" for="end_date">To</label>
                    <input type="date" class="form-control" id="end_date" name="end_date"
                           value="<?= h($end_date) ?>">
                </div>
                <div class="col-sm-2 col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>Filter
                    </button>
                    <?php if ($start_date || $end_date): ?>
                    <a href="index.php" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg"></i>
                    </a>
                    <?php endif; ?>
                </div>
            </form>
        </div>
    </div>

    <!-- Results summary -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <small class="text-muted">
            <?php if ($total === 0): ?>
                No appointments found.
            <?php elseif ($pages > 1): ?>
                Page <?= $page ?> of <?= $pages ?> &mdash; <?= number_format($total) ?> total
            <?php else: ?>
                <?= $total ?> appointment<?= $total !== 1 ? 's' : '' ?>
            <?php endif; ?>
        </small>
    </div>

    <?php if (!empty($rows)): ?>

    <!-- Appointments table -->
    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" style="width:3.5rem">#</th>
                        <th scope="col">Title</th>
                        <th scope="col">Location</th>
                        <th scope="col">Contact Info</th>
                        <th scope="col">Start</th>
                        <th scope="col">End</th>
                        <th scope="col" class="text-center" style="width:7rem">Actions</th>
                    </tr>
                </thead>
                <tbody>
                <?php foreach ($rows as $row): ?>
                <tr>
                    <td class="text-muted small"><?= (int) $row['id'] ?></td>
                    <td class="fw-semibold"><?= h($row['title']) ?></td>
                    <td class="text-muted small"><?= h($row['location']) ?: '—' ?></td>
                    <td class="text-muted small"><?= h($row['contact_info']) ?: '—' ?></td>
                    <td class="text-nowrap small"><?= h(fmtDt($row['start_date_and_time'])) ?></td>
                    <td class="text-nowrap small"><?= h(fmtDt($row['end_date_and_time'])) ?></td>
                    <td class="text-center">
                        <a href="edit.php?id=<?= (int) $row['id'] ?>"
                           class="btn btn-sm btn-outline-primary btn-icon me-1"
                           title="Edit">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        <form method="post" class="d-inline"
                              onsubmit="return confirm('Delete this appointment?')">
                            <input type="hidden" name="action"     value="delete">
                            <input type="hidden" name="id"         value="<?= (int) $row['id'] ?>">
                            <input type="hidden" name="start_date" value="<?= h($start_date) ?>">
                            <input type="hidden" name="end_date"   value="<?= h($end_date) ?>">
                            <input type="hidden" name="page"       value="<?= $page ?>">
                            <button type="submit" class="btn btn-sm btn-outline-danger btn-icon"
                                    title="Delete">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <?php if ($pages > 1): ?>
    <nav aria-label="Appointment pages" class="mb-4">
        <ul class="pagination justify-content-center">

            <li class="page-item <?= $page <= 1 ? 'disabled' : '' ?>">
                <a class="page-link" href="<?= h(pageUrl($filterParams, $page - 1)) ?>" aria-label="Previous">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>

            <?php
            // Show first 2, window around current, last 2; insert ellipsis for gaps
            $prev = null;
            $show = array_values(array_unique(array_filter(
                range(1, $pages),
                fn($i) => $i <= 2 || $i >= $pages - 1 || abs($i - $page) <= 1
            )));
            foreach ($show as $i):
                if ($prev !== null && $i - $prev > 1): ?>
                    <li class="page-item disabled"><span class="page-link px-2">&hellip;</span></li>
                <?php endif; ?>
                <li class="page-item <?= $i === $page ? 'active' : '' ?>">
                    <a class="page-link" href="<?= h(pageUrl($filterParams, $i)) ?>"><?= $i ?></a>
                </li>
            <?php $prev = $i; endforeach; ?>

            <li class="page-item <?= $page >= $pages ? 'disabled' : '' ?>">
                <a class="page-link" href="<?= h(pageUrl($filterParams, $page + 1)) ?>" aria-label="Next">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>

        </ul>
    </nav>
    <?php endif; ?>

    <?php else: ?>
    <!-- Empty state -->
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-calendar-x display-3 text-muted"></i>
            <p class="text-muted mt-3 mb-4">
                No appointments found<?= ($start_date || $end_date) ? ' for the selected date range' : '' ?>.
            </p>
            <a href="edit.php" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Add an Appointment
            </a>
        </div>
    </div>
    <?php endif; ?>

    <!-- Add button at bottom -->
    <div class="text-center mt-4">
        <a href="edit.php" class="btn btn-success btn-lg px-5 shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>Add New Appointment
        </a>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
