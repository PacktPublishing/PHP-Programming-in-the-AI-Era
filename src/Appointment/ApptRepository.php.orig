<?php
namespace Cookbook\Appointment;
use PDO;
use PDOStatement;
use Cookbook\Appointment\ApptAdapter;
use Cookbook\Appointment\Appointment;
class ApptRepository
{
    public ?PDO $pdo = null;
    // fill in this array with the columns for the "appointment" table
    public array $cols = []; 
    public function __construct(array $config) 
    {
        $this->pdo = ApptAdapter::getInstance($config);
    }
    public function buildCols() : string
    {
        $cols = '';
        foreach ($this->cols as $name)
            $cols .= $this->pdo->quote($name) . ',';
        return substr($cols, 0, -1);    // last arg removes trailing comma
    }
